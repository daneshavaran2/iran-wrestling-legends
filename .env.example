# --- Frontend (Vite) ---
# In production behind nginx, leave as /api. For local dev pointing at the API
# directly, use: VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_BASE_URL=/api

# --- Backend (Node.js / Fastify) ---
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
CORS_ORIGIN=*

# Lovable AI Gateway key — used server-side only, never exposed to the browser.
LOVABLE_API_KEY=
